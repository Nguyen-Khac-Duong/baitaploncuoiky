{
  "hooks": {
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .specify/events.py speckit.companion.on-prompt user_prompt_submit 10 hookSpecificOutput BeforeAgent",
            "timeout": 15000,
            "__speckit_event__": true
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .specify/events.py speckit.companion.on-stop stop 10 suppress",
            "timeout": 15000,
            "__speckit_event__": true
          }
        ]
      }
    ]
  }
}
